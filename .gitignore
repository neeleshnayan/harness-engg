__pycache__/
*.pyc
.venv/
venv/
.env
# service-account credentials — the production key is a different filename,
# so match the family, not one exact name
firebase_service_account*.json
*-service-account*.json
scratch_*
*.log
.firestore_local_db.json
# ...and its rotated backups / quarantined copies. Each is a full copy of the
# fund's event log, so an unanchored pattern here would commit the whole ledger.
.firestore_local_db.json.*
*.db

# Live-session telemetry — machine state, not source.
logs/
# Engine OUTPUT only. The algorithms are source and are versioned: every
# research note in docs/ says "reproduce with this script", and that sentence is
# false if the algorithm the script runs is not in the repo. Results are 87MB of
# regenerable JSON; the algorithms are 76KB of the actual research.
lean_workspace/results/

# Pinned bar snapshots, same reasoning: regenerable vendor data, not research.
# MEASURED 2026-08-22: one 170-leg candidate is 7.40 MB, so a hundred of them
# would be 740 MB of bars the vendor will serve again on request. Retention is
# bounded in code (barcache.prune_snapshots) as well as ignored here.
lean_workspace/snapshots/

# agent worktrees + deliverables (never repo content)
.claude/
