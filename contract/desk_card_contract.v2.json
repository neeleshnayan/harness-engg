  "done",
  "declined",
  "superseded",
  "merged",
  "expired"
 ],
 "controls": [
  "decide",
  "execute",
  "none"
 ],
 "lamps": [
  "working",
  "awaiting-review",
  "idle",
  "record"
 ],
 "invariants": [
  "a terminal ticket offers NO control, under every next_actor",
  "a terminal ticket is counted as awaiting NOBODY",
  "`controls` and `countedAsAwaiting` are computed independently — a row with no control may still have somebody waiting on it",
  "`controlsWhy` is never empty, so a missing control is never a blank",
  "an unreadable age is null with ageKnown false, never 0",
  "a `done` ticket with no citation is flagged as a bookkeeping gap"
 ],
