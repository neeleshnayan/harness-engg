# KryptonPay – Environment Configuration Template
# Copy to .env.local for local development. Do not commit .env.local.

# ClarkHarness fund spine (local Tier 1 API)
NEXT_PUBLIC_HARNESS_API_URL=http://127.0.0.1:8090

# Clark / Agent orchestrator API (local Tier 2 API)
NEXT_PUBLIC_AGENTS_API_URL=http://127.0.0.1:8000

# Main backend (auth, user, wallet)
NEXT_PUBLIC_API_URL=https://api.kryptonfund.com

# Web3 / Krypton backend
NEXT_PUBLIC_KRYPTON_WEB3_API_URL=https://kryptonweb3-production.up.railway.app

# Hedge Fund API backend
NEXT_PUBLIC_HEDGE_FUND_API_URL=https://kryptonhedgefund-production.up.railway.app

NEXT_PUBLIC_SUBGRAPH_URL=https://api.studio.thegraph.com/query/121450/hedge-fund-v-2/version/latest
NEXT_PUBLIC_TX_DEBUG=1
