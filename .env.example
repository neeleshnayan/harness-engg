# Copy to .env (git-ignored) and fill in. Never commit real secrets.

# Firebase Admin service-account JSON (path)
FIREBASE_SERVICE_ACCOUNT_JSON=firebase_service_account.json

# CORS (comma-separated); the LP view / cockpit origins
CORS_ORIGINS=http://localhost:3000

# --- Execution venue ---
# Leave ALPACA_API_KEY unset to use the in-Firestore paper connector.
# Set both keys to route execution through Alpaca (paper by default).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# "true" (paper, https://paper-api.alpaca.markets) or "false" (live). Default true.
ALPACA_PAPER=true
