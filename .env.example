# Krypton Fund — environment template.
# Copy to .env and fill in. NEVER commit the filled-in file: .env is gitignored
# and must stay that way. The Firebase service account is full admin on the
# fund's append-only ledger, and the Alpaca keys can trade.

# --- broker (Alpaca) ---------------------------------------------------------
# Paper vs LIVE is decided by FUND_MODE, not by a variable here. ALPACA_PAPER
# was a fourth accidental switch: it decided real money while living beside a
# CORS list, tied to nothing the rest of the fund could see.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Seconds a price mark is reused before refetching. 5 suits the trade path;
# 15 is kinder to the API during a live session.
ALPACA_PRICE_TTL=15

# CORS (comma-separated) — the LP view / cockpit origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- ledger -----------------------------------------------------------------
# Path to the Firebase service-account JSON. Keep it OUTSIDE the repo.
FIREBASE_SERVICE_ACCOUNT_JSON=firebase_service_account.json
# The fund's production project uses a NAMED database called "default" — not
# "(default)". The SDK 404s if this is not passed through.
FIRESTORE_DATABASE_ID=default
FUND_ENV=staging

# --- THE FUND'S MODE (required; there is NO default) -------------------------
# One switch, TWO dimensions: where orders go x where events land.
#
#   test          simulated fills at REAL prices  ->  krypton_fund_test
#   alpaca-paper  the Alpaca paper account        ->  krypton_fund
#   alpaca-prod   the Alpaca LIVE account         ->  krypton_fund_prod
#
# UNSET FAILS. The spine refuses to start rather than pick one, because the
# three implicit switches this replaces (USE_FAKE_FIRESTORE, FUND_REAL_BROKER,
# and the mere presence of ALPACA_API_KEY) each produced a fund quietly doing
# something other than what its operator believed — twice, on 2026-08-21.
#
# alpaca-prod is STRUCTURALLY UNREACHABLE: a code constant plus five
# CEO-agreed preconditions, all of which must read "met". See app/fund/mode.py.
FUND_MODE=test
# Which backend the event log lives on: postgres | firestore. ALSO no default —
# the previous default ("firestore") relocated the entire ledger on a restart
# that did not carry this variable. Which DATABASE within postgres is decided
# by FUND_MODE, not here.
FUND_STORE=postgres
# The BASE connection string. The database in it is a placeholder — FUND_MODE
# replaces the last path segment.
FUND_PG_DSN=postgresql://krypton:krypton_local@127.0.0.1:5433/krypton_fund

# --- local development ------------------------------------------------------
# Mark simulated positions at live market prices. Fills are fake; the prices
# they fill at are real.
FUND_LIVE_MARKS=true
# 1 = start with an empty book instead of auto-seeding invented demo state.
DISABLE_DEMO_SEED=1

# --- worker -----------------------------------------------------------------
ENABLE_SCHEDULER=true
# How often in-flight orders are polled to terminal. This is how long a fill can
# sit unrecorded: NAV stale, the reconciler reporting a divergence that is not
# real, and the risk engine evaluating a book that no longer exists. Keep it
# tight until the trade_updates websocket replaces polling.
SETTLE_INTERVAL_SECONDS=20

# Live fill events over Alpaca's trade_updates websocket, so a fill reaches the
# ledger in about a second instead of within one poll. OFF by default: the
# poller is what the fund has always run on and stays running underneath as the
# backstop (every write path is idempotent, so a fill seen twice is recorded
# once). Turn on once it has proved itself over a real session.
ENABLE_TRADE_STREAM=false
STRIKE_INTERVAL_SECONDS=1800
